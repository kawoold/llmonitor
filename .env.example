# Anthropic API key — passed through to upstream requests
# Required
ANTHROPIC_API_KEY=sk-ant-...

# Admin username for the management UI and API
# Required
ADMIN_USERNAME=admin

# Admin password for the management UI and API
# Required
ADMIN_PASSWORD=changeme

# SQLite database file path (plain path or sqlite:// URI — both accepted)
# Default when unset: llmonitor.db in the current directory
# The Docker image sets DATABASE_URL=/data/llmonitor.db via its Dockerfile ENV —
# do NOT set this here when using docker-compose, or the env_file will override
# the Dockerfile default and the database will land outside the persistent volume.
# DATABASE_URL=llmonitor.db
